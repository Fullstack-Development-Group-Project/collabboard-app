{
  "info": {
    "name": "CollabBoard API - Assignment 03",
    "description": "RESTful API routes for the SyncBoard/CollabBoard application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Boards & Tasks (Protected)",
      "item": [
        {
          "name": "Get All Boards",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/boards", "host": ["{{base_url}}"], "path": ["api", "v1", "boards"] }
          }
        },
        {
          "name": "Create Board",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Q4 Marketing Campaign\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/boards", "host": ["{{base_url}}"], "path": ["api", "v1", "boards"] }
          }
        },
        {
          "name": "Create Task",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
            },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Write press release\",\n  \"description\": \"Draft the initial announcement for the new product.\",\n  \"priority\": \"High\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/boards/REPLACE_WITH_BOARD_ID/tasks", "host": ["{{base_url}}"], "path": ["api", "v1", "boards", "REPLACE_WITH_BOARD_ID", "tasks"] }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://www.collabboard.tech"
    },
    {
      "key": "token",
      "value": "PASTE_YOUR_LOGIN_TOKEN_HERE"
    }
  ]
}
